{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bernaferrari/screenshot-studio/schemas/studio.schema.json",
  "title": "Screenshot Studio settings (store-listing/studio.json)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "app": {
      "type": "string",
      "description": "The app's name, for the editor and README name banners."
    },
    "package": {
      "type": "string",
      "description": "The app's package or bundle ID."
    },
    "locales": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/locale"
      },
      "minItems": 1,
      "description": "Every language the listing is made in."
    },
    "defaultLocale": {
      "$ref": "#/$defs/locale",
      "description": "The reference language other languages fall back to."
    },
    "supersample": {
      "type": "number",
      "minimum": 1,
      "maximum": 4,
      "description": "Render at this multiple and scale down; 2 keeps scaled UI crisp."
    },
    "jpegQuality": {
      "type": "number",
      "minimum": 1,
      "maximum": 100
    },
    "rtl": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/locale"
      },
      "description": "Languages written right to left."
    },
    "minFit": {
      "type": "number",
      "minimum": 0.3,
      "maximum": 1,
      "description": "The smallest size headlines may shrink to (default 0.72)."
    },
    "writeAssets": {
      "type": "boolean"
    },
    "contactSheets": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "const": false
          }
        ]
      }
    },
    "frames": {
      "anyOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "properties": {
            "phone": {
              "$ref": "#/$defs/ratio"
            },
            "iphone": {
              "$ref": "#/$defs/ratio"
            },
            "tablet": {
              "$ref": "#/$defs/ratio"
            },
            "browser": {
              "$ref": "#/$defs/ratio"
            },
            "landscape": {
              "$ref": "#/$defs/ratio"
            },
            "fixed": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Layouts whose CSS sizes their own frames."
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "bounds": {
      "type": "object",
      "properties": {
        "margin": {
          "type": "number"
        },
        "visible": {
          "type": "number"
        },
        "sides": {
          "type": "boolean"
        },
        "right": {
          "type": [
            "boolean",
            "number"
          ]
        },
        "top": {
          "type": "boolean"
        },
        "cut": {
          "type": "boolean"
        },
        "layouts": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/bounds"
              },
              {
                "const": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "icon": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "readmeStrips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "kind",
          "cards"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "cards": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "height": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "fastlane": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string"
        },
        "screenshots": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "screenshotLocales": {
          "anyOf": [
            {
              "const": "all"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/locale"
              }
            }
          ]
        },
        "locales": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "properties": {
        "platform": {
          "enum": [
            "android",
            "ios"
          ],
          "description": "Where captures come from: an Android emulator (default) or an iOS simulator."
        },
        "build": {
          "type": "string",
          "description": "Shell command that builds the capture app, run from the repository."
        },
        "install": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "package"
            ],
            "anyOf": [
              {
                "required": [
                  "apk"
                ]
              },
              {
                "required": [
                  "app"
                ]
              }
            ],
            "properties": {
              "apk": {
                "type": "string",
                "description": "Android: the APK to install."
              },
              "app": {
                "type": "string",
                "description": "iOS: the simulator .app to install."
              },
              "package": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "script": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "profiles": {
                "anyOf": [
                  {
                    "const": false
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "locales": {
                "anyOf": [
                  {
                    "enum": [
                      "all",
                      "default"
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/locale"
                    }
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "export": {
          "type": "string"
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "serial": {
          "type": "string",
          "pattern": "^emulator-\\d+$",
          "description": "The capture emulator."
        },
        "avd": {
          "type": "string",
          "description": "The emulator image `recapture --boot` starts."
        },
        "simulator": {
          "type": "string",
          "description": "The iOS simulator a capture runs on."
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "ratio": {
      "type": "object",
      "required": [
        "bezel",
        "radius"
      ],
      "properties": {
        "bezel": {
          "type": "number"
        },
        "radius": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "properties": {
        "margin": {
          "type": "number"
        },
        "visible": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sides": {
          "type": "boolean"
        },
        "right": {
          "type": [
            "boolean",
            "number"
          ]
        },
        "top": {
          "type": "boolean"
        },
        "cut": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
