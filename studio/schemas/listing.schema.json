{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bernaferrari/screenshot-studio/schemas/listing.schema.json",
  "title": "Store listing text (store-listing/<locale>/listing.json)",
  "description": "<locale>/listing.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "appName": {
      "type": "string"
    },
    "shortDescription": {
      "type": "string"
    },
    "fullDescription": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "promotionalText": {
      "type": "string"
    },
    "keywords": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "whatsNew": {
      "type": "string"
    },
    "developer": {
      "type": "string",
      "description": "The developer name the store shows under the title (the editor's store preview only)."
    }
  },
  "additionalProperties": true,
  "$defs": {}
}
