{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bernaferrari/screenshot-studio/schemas/copy.schema.json",
  "title": "Screenshot Studio words (store-listing/<locale>/copy.json)",
  "type": "object",
  "properties": {"$schema": {"type": "string"}},
  "additionalProperties": {"type": "object", "properties": {
    "title": {"type": "string", "description": "The headline: *highlight*, ~old~, [new], \\n for a new line."},
    "body": {"type": "string"}, "alt": {"type": "string"}, "tagline": {"type": "string"}
  }, "additionalProperties": {"type": "string"}}
}
