{
  "name": "screenshot-studio",
  "version": "0.1.0",
  "description": "Real app screens in, Google Play and README art out: captures, themes, every language, checked.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bernaferrari/screenshot-studio.git"
  },
  "homepage": "https://github.com/bernaferrari/screenshot-studio",
  "keywords": [
    "screenshots",
    "app-store",
    "google-play",
    "play-store",
    "android",
    "fastlane",
    "marketing",
    "playwright",
    "agents",
    "mcp"
  ],
  "type": "module",
  "bin": {
    "screenshot-studio": "studio/studio.cjs"
  },
  "main": "studio/studio.cjs",
  "types": "studio/types.d.ts",
  "exports": {
    ".": {
      "types": "./studio/types.d.ts",
      "default": "./studio/studio.cjs"
    },
    "./shapes": {
      "types": "./studio/shapes.d.ts",
      "default": "./studio/shapes.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "llms.txt",
    "docs/*.md",
    "skills",
    "studio",
    "templates",
    "themes",
    "!themes/*/preview.jpg"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:studio && npm run build:ui",
    "prepack": "npm run build",
    "test": "node --test test/gallery.test.cts test/layout.test.cts test/workspace.test.cts test/ios.test.cts test/schemas.test.cts test/icon.test.cts test/check.test.cts test/tailwind.test.cts test/init.test.cts test/capture.test.cts test/editor.test.mts test/export.test.cts",
    "test:ui": "node --test test/navigation.browser.cts",
    "build:studio": "npm run schemas && tsc -p tsconfig.json && tsc -p tsconfig.shapes.json && node scripts/build-studio.mts",
    "build:ui": "vite build && node scripts/install-ui.mts",
    "schemas": "node scripts/schemas.mts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json && tsc -p tsconfig.themes.json",
    "test:golden": "node --test test/golden.test.cts test/demo.test.cts"
  },
  "dependencies": {
    "agent-device": "^0.21.35",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.180.0",
    "ts-json-schema-generator": "^2.9.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
