{
  "name": "screenshot-studio",
  "version": "0.0.1",
  "description": "Real app screens in, Google Play and README art out: captures, themes, every language, checked.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bernaferrari/screenshot-studio.git"
  },
  "homepage": "https://github.com/bernaferrari/screenshot-studio",
  "keywords": [
    "screenshots",
    "app-store",
    "google-play",
    "play-store",
    "android",
    "fastlane",
    "marketing",
    "playwright",
    "agents",
    "mcp"
  ],
  "type": "module",
  "bin": {
    "screenshot-studio": "studio/studio.cjs"
  },
  "main": "studio/studio.cjs",
  "types": "studio/types.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "docs/*.md",
    "skills",
    "studio",
    "templates",
    "themes",
    "!themes/*/preview.jpg"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:studio && npm run build:ui",
    "test": "node --test test/gallery.test.cjs test/layout.test.cjs test/workspace.test.cjs test/ios.test.cjs test/schemas.test.cjs test/icon.test.cjs test/editor.test.mjs",
    "test:ui": "node --test test/navigation.browser.cjs",
    "build:studio": "npm run schemas && tsc -p tsconfig.json && node scripts/build-studio.mjs",
    "build:ui": "vite build && node scripts/install-ui.mjs",
    "schemas": "node scripts/schemas.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json",
    "test:golden": "node --test test/golden.test.cjs"
  },
  "dependencies": {
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "ts-json-schema-generator": "^2.9.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
