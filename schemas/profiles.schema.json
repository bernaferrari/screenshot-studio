{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bernaferrari/screenshot-studio/schemas/profiles.schema.json",
  "title": "Screenshot Studio galleries' sizes (store-listing/profiles.json)",
  "type": "object",
  "properties": {"$schema": {"type": "string"}},
  "additionalProperties": {"$ref": "#/$defs/profile"},
  "$defs": {
    "profile": {"type": "object", "required": ["width", "height"], "properties": {
      "width": {"type": "integer", "minimum": 1, "description": "The exported image's width."},
      "height": {"type": "integer", "minimum": 1},
      "captureWidth": {"type": "integer", "minimum": 1, "description": "The device display this gallery's captures are taken at."},
      "captureHeight": {"type": "integer", "minimum": 1},
      "captureDensity": {"type": "integer", "minimum": 1},
      "frame": {"enum": ["phone", "iphone", "tablet", "browser", "none"]},
      "label": {"type": "string", "description": "The gallery's name in the editor."},
      "defaultLocaleOnly": {"type": "boolean", "description": "Render once, in the default language (README art)."},
      "platform": {"enum": ["android", "ios", "web"], "description": "Which capture backend takes this gallery's captures."},
      "simulator": {"type": "string", "description": "iOS: the simulator (name or UDID) this gallery is captured on."}
    }, "additionalProperties": false}
  }
}
